    "variables": {
      "v_dates": {
        "type": "Array"
      }
    },
    "activities": [
      {
        "name": "build_dates",
        "type": "SetVariable",
        "dependsOn": [],
        "typeProperties": {
          "variableName": "v_dates",
          "value": {
            "value": "@range(0,add(div(sub(ticks(pipeline().parameters.p_end_date),ticks(pipeline().parameters.p_start_date)),864000000000),1))",
            "type": "Expression"
          }
        }
      },
      {
        "name": "run_each_day",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "build_dates",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "isSequential": true,
          "items": {
            "value": "@variables('v_dates')",
            "type": "Expression"
          },
          "activities": [
            {
              "name": "run_master_daily",
              "type": "TridentNotebook",
              "dependsOn": [],
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 1,
                "retryIntervalInSeconds": 60
              },
              "typeProperties": {
